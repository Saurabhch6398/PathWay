# --- API ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/pathway
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
CLIENT_URL=http://localhost:5173
# AI features (quizzes, skill gap, advisor, helpdesk). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated model names, tried in order
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- Optional production settings (see docs/DEPLOYMENT.md) ---
# NODE_ENV=production
# TRUST_PROXY=1        # reverse proxies in front of the app; defaults to 1 in production
# STATIC_DIR=          # built web app; defaults to apps/web/dist in production
