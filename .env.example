# --- API ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/pathway
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
CLIENT_URL=http://localhost:5173
# AI features (quizzes, skill gap, advisor, helpdesk).
# Option A: Groq (ultra-fast, recommended). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq models tried in order if one is unavailable
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Option B: Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini models tried in order if one is unavailable
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-flash-latest,gemini-flash-lite-latest

# Optional: When 'true', all AI features work immediately even if no API keys are provided
AI_OFFLINE_MODE=true

# --- Optional production settings (see docs/DEPLOYMENT.md) ---
# NODE_ENV=production
# TRUST_PROXY=1        # reverse proxies in front of the app; defaults to 1 in production
# STATIC_DIR=          # built web app; defaults to apps/web/dist in production
